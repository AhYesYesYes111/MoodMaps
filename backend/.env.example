APP_ENV=development
DEMO_MODE=true
ALLOWED_ORIGINS=*
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=2048
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_MAX_CLIENTS=10000
MAX_REQUEST_BODY_BYTES=16384

# Optional live-provider settings. They are unused in the default demo mode and
# are never required by the Chrome extension.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_TIMEOUT_SECONDS=8
GOOGLE_WEATHER_ENABLED=false
GOOGLE_WEATHER_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
